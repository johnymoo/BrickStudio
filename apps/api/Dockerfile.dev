# Local development overrides for apps/api/Dockerfile.
# Use as: docker build -f apps/api/Dockerfile.dev ...
# Allows fast iteration: bind-mount source, enable reload, run as root.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl ca-certificates tini git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.4.18 /uv /uvx /usr/local/bin/

WORKDIR /app

# In dev we `uv sync` inside the running container, so just copy manifests.
COPY pyproject.toml uv.lock* ./
COPY apps/api/pyproject.toml ./apps/api/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project apps/api --no-install-project

COPY apps/api /app/apps/api

ENV PATH="/app/apps/api/.venv/bin:$PATH"

# uvicorn resolves modules relative to CWD; set WORKDIR to the source tree.
WORKDIR /app/apps/api

EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "src.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
