# =============================================================================
# 积木建模工具 — deploy/.env.example
# Copy to deploy/.env and tweak as needed. NEVER commit the real .env.
# =============================================================================

# ------------------------------ Core ----------------------------------------
# Project name (used for image tags and the docker compose project name)
PROJECT_NAME=blocktool

# Comma-separated compose files to merge (override per-environment).
# Leave empty for default behavior; .env file alone is enough for v0.1.
COMPOSE_FILE=docker-compose.yml

# ------------------------------ Postgres ------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blocktool
POSTGRES_USER=blocktool
POSTGRES_PASSWORD=blocktool_dev_pw_change_me
# Aggregated URL consumed by the API / alembic.
DATABASE_URL=postgresql+asyncpg://blocktool:blocktool_dev_pw_change_me@postgres:5432/blocktool
DATABASE_URL_SYNC=postgresql://blocktool:blocktool_dev_pw_change_me@postgres:5432/blocktool

# ------------------------------ Redis ---------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1

# ------------------------------ MinIO / S3 ----------------------------------
MINIO_ROOT_USER=blocktool
MINIO_ROOT_PASSWORD=blocktool_dev_secret_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_CAPTURES=blocktool
MINIO_BUCKET_RECON=blocktool-recon
# Internal service endpoint used by the API's S3 client for object operations.
S3_ENDPOINT=http://minio:9000
# Browser-reachable S3 API origin used to sign presigned download URLs.
# Must be a root origin only: no path, query, or fragment. S3 signatures bind
# the canonical path and host, so values like http://localhost/minio will fail.
# For Docker dev/LAN, use the exposed MinIO API port, for example:
#   http://localhost:9000
#   http://<LAN-IP>:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=blocktool
S3_SECRET_KEY=blocktool_dev_secret_change_me
S3_BUCKET_CAPTURES=blocktool
S3_BUCKET_RECON=blocktool-recon

# ------------------------------ API -----------------------------------------
# Where the API listens inside the container.
API_HOST=0.0.0.0
API_PORT=8000
# Public base URL the front-end uses to reach the API (browser-visible).
PUBLIC_API_BASE_URL=http://localhost/api
# Where the front-end lives publicly (used for CORS).
PUBLIC_WEB_BASE_URL=http://localhost
# Direct dev endpoints used when docker-compose.dev.yml publishes services.
DEV_PUBLIC_API_BASE_URL=http://localhost:8000
DEV_PUBLIC_WEB_BASE_URL=http://localhost:5173
# Where MinIO console is reachable when docker-compose.dev.yml publishes MinIO.
PUBLIC_MINIO_CONSOLE_URL=http://localhost:9001
# Shared secret required by PATCH /api/v1/library/{id}.
# Set this before using library mutation APIs.
LIBRARY_ADMIN_TOKEN=

# Logging
LOG_LEVEL=info
PYTHONUNBUFFERED=1

# ------------------------------ 3D Reconstruction (phase 2) ----------------
# Path to the COLMAP binary. Leave empty to auto-detect via `which colmap`.
# Production: /opt/homebrew/bin/colmap (macOS) or /usr/local/bin/colmap (Linux).
# In Docker images that don't ship COLMAP, leave blank — the worker
# automatically falls back to the Open3D multi-photo path (8+ photos) or
# the Open3D 4-7 photo icosahedron fallback.
COLMAP_BIN=
# Minimum photo count required to even attempt the COLMAP path. The
# design-phase2 default is 8. The Open3D paths handle 4-20 photos.
RECONSTRUCT_MIN_IMAGES_FOR_COLMAP=8

# ------------------------------ Caddy / Proxy -------------------------------
# The Caddyfile listens on 80/443 and reverse-proxies /api -> api:8000, /minio -> minio:9000.
PROXY_HTTP_BIND=127.0.0.1
PROXY_HTTP_PORT=80
PROXY_HTTPS_BIND=127.0.0.1
PROXY_HTTPS_PORT=443
S3_PROXY_BIND=127.0.0.1
S3_PROXY_PORT=9000

# ------------------------------ Web (Vite dev) ------------------------------
# When running docker-compose.dev.yml, vite is bound to 5173 inside the container
# and published to the host on the same port.
WEB_DEV_PORT=5173
