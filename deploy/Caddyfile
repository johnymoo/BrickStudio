# =============================================================================
# Caddy reverse-proxy for the full stack.
#
# Routes:
#   /api/*        -> api:8000      (FastAPI)
#   /minio/*      -> minio:9000    (path-proxied S3 API route for legacy/direct
#                                  browser fetches; do not use this path as
#                                  S3_PUBLIC_ENDPOINT for presigned URLs)
#   /healthz      -> web:80        (nginx healthcheck inside the web image)
#   /*            -> web:80        (PWA static bundle)
#
# CORS:
#   - OPTIONS preflights are short-circuited to a 204 with the standard
#     allow-* headers, so the PWA can call /api and /minio cross-origin
#     in dev.
#   - All /api/* and /minio/* responses get Access-Control-Allow-Origin: *
#     to keep tests + dev frictionless.
#
# Caddy already forwards X-Forwarded-For / X-Forwarded-Proto to upstreams
# by default, so we don't set those explicitly (would be redundant).
# =============================================================================

(app_routes) {
	# CORS preflight short-circuit. Must come BEFORE the API / MinIO
	# handle blocks so OPTIONS /api/* does not get proxied upstream.
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
		header Access-Control-Max-Age "3600"
		respond "" 204
	}

	# Health endpoint exposed by the web container.
	handle /healthz {
		reverse_proxy web:80
	}

	# API.
	handle /api/* {
		reverse_proxy api:8000
	}

	# MinIO API path proxy. S3_PUBLIC_ENDPOINT must point at a root S3 API
	# origin such as http://localhost:9000 or a dedicated host, not /minio.
	handle /minio/* {
		reverse_proxy minio:9000
	}

	# Web (default).
	handle {
		reverse_proxy web:80
	}

	# Permissive CORS for API + MinIO paths in dev. Browsers only honour
	# these on actual responses, not preflights (handled above).
	header /api/* Access-Control-Allow-Origin "*"
	header /minio/* Access-Control-Allow-Origin "*"

	encode zstd gzip
	log
}

:{$PROXY_HTTP_PORT:80} {
	import app_routes
}

:443 {
	import app_routes
}

:9000 {
	@s3_cors_preflight method OPTIONS
	handle @s3_cors_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, PUT, POST, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Amz-Date, X-Amz-Content-Sha256, X-Amz-Security-Token"
		header Access-Control-Max-Age "3600"
		respond "" 204
	}

	handle {
		reverse_proxy minio:9000
	}

	header Access-Control-Allow-Origin "*"

	encode zstd gzip
	log
}
